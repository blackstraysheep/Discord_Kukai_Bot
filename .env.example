# Discord Bot token (required)
BOT_TOKEN=your_bot_token_here

# SQLite DB path (default: ./data/kukai.db)
DATABASE_URL=sqlite+aiosqlite:///./data/kukai.db
# PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://kukai:kukai@db:5432/kukai

# APScheduler job store DB path (use separate SQLite file to avoid lock contention)
SCHEDULER_DB_URL=sqlite:///./data/kukai_scheduler.db
# PostgreSQL example:
# SCHEDULER_DB_URL=postgresql+psycopg://kukai:kukai@db:5432/kukai

# Data directory for DB and exports
DATA_DIR=./data

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Comma-separated Discord guild IDs for dev (fast command sync, leave empty for global)
DEV_GUILD_IDS=

# PDF generation (leave LUALATEX_BIN empty to disable PDF feature)
LUALATEX_BIN=/usr/bin/lualatex
PDF_MAX_CONCURRENT=2
PDF_COMPILE_TIMEOUT=60

# Temporary URL serving for large PDFs (leave empty if not using Caddy)
PDF_SERVE_BASE_URL=
PDF_SERVE_DIR=/srv/pdfs
