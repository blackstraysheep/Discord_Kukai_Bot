\begin{document}

%% タイトル
{\gtfamily\Large {{ title | tex_tcy }}　結果}\par
\vspace{.7\baselineskip}
{\small {{ date | tex_tcy }}{% if kukai_theme %}\quad 兼題：{{ kukai_theme | tex }}{% endif %}{% if participants %}\quad 参加者：{% for p in participants %}{{ p | tex }}{% if not loop.last %}・{% endif %}{% endfor %}{% endif %}}\par
\vspace{1.2\baselineskip}

\begin{multicols*}{3}

{% set ns = namespace(last_score=None) %}
{% for r in results %}
{%- if r.score != ns.last_score %}
{% set ns.last_score = r.score %}
\vspace{.1\baselineskip}
{\bfseries\large \rensuji{ {{ r.score }} }点句}\par
\vspace{.25\baselineskip}
{% endif %}

%% 句
{\scriptsize \hspace*{.5\zw}\rensuji{No.{{ r.number }}}}\quad{\large\kintou{17}{ {{- r.text | tex -}} }}\par
{%- if r.author %}
\hfill{\small {{ r.author | tex }}}\par
{%- endif %}

%% 得票サマリ
{% for ls in r.label_selects %}{% if ls.count %}
{\leftskip=1\zw{\gtfamily\small {{ ls.label | tex }}}{\mcfamily\small （\rensuji{ {{ ls.point }} }点）×\rensuji{ {{ ls.count }} }{% if ls.all_selectors %}（{% for name in ls.all_selectors %}{{ name | tex }}{% if not loop.last %}・{% endif %}{% endfor %}）{% endif %}}\par}%
{% endif %}{% endfor %}

%% 選評
{% for ls in r.label_selects %}{% if ls.comments %}
{\leftskip=1\zw{\gtfamily\small {{ ls.label | tex }}}\par}%
{% for c in ls.comments %}
{\leftskip=2\zw{\small {{ c.text | tex }}{% if c.author %}\unskip\nobreak\hfill\hbox{\tate\small ――{{ c.author | tex }}}\parfillskip=0pt{% endif %}}\par}%
{% endfor %}
{% endif %}{% endfor %}
\vspace{1\baselineskip}
{% endfor %}

{% if overall_comments %}
%% 総評
\vspace{.5\baselineskip}
\noindent\rule{\linewidth}{.3pt}\par
\vspace{.5\baselineskip}
{\gtfamily\large 総評}\par
\vspace{.5\baselineskip}
{% for oc in overall_comments %}
{\leftskip=1\zw
{\small {{ oc.text | tex }}{% if oc.author %}\unskip\nobreak\hfill\hbox{\tate\small ――{{ oc.author | tex }}}\parfillskip=0pt{% endif %}}\par}%
\vspace{.5\baselineskip}
{% endfor %}
{% endif %}

\end{multicols*}
\end{document}
