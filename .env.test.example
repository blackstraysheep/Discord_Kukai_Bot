# Local/staging test bot token. Use a separate Discord application from production.
BOT_TOKEN=your_test_bot_token_here

# Keep test command sync limited to the test Discord server for fast updates.
DEV_GUILD_IDS=your_test_guild_id_here

# Local test PostgreSQL settings. Do not copy production values here.
POSTGRES_DB=kukai_test
POSTGRES_USER=kukai_test
POSTGRES_PASSWORD=change-me-local-test-only

# The test compose file provides db as the PostgreSQL hostname.
DATABASE_URL=postgresql+asyncpg://kukai_test:change-me-local-test-only@db:5432/kukai_test
SCHEDULER_DB_URL=postgresql+psycopg://kukai_test:change-me-local-test-only@db:5432/kukai_test

DATA_DIR=./data
LOG_LEVEL=INFO

# PDF generation inside the bot container.
LUALATEX_BIN=/usr/bin/lualatex
PDF_MAX_CONCURRENT=2
PDF_COMPILE_TIMEOUT=60

# Leave empty for local test unless a temporary PDF server is configured.
PDF_SERVE_BASE_URL=
PDF_SERVE_DIR=/srv/pdfs
